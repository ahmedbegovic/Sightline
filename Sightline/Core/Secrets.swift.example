/// Copy this file to Secrets.swift in the same folder and fill in real values; the .example suffix keeps this template out of the build.
enum Secrets {
    /// Google Maps Platform key (Places API (New) only) — must stay restricted to bundle id com.ahmedbegovic.Sightline.
    /// Used only when a place card or the AI guide opens; scanning never calls Google.
    static let googleAPIKey = "YOUR_GOOGLE_MAPS_PLATFORM_KEY"
}
