/// Copy this file to Secrets.swift in the same folder and fill in real values; the .example suffix keeps this template out of the build.
enum Secrets {
    /// Google Maps Platform key from the Google Cloud console (the "Sightline" project) — must stay restricted to bundle id com.ahmedbegovic.Sightline.
    static let googleAPIKey = "YOUR_GOOGLE_MAPS_PLATFORM_KEY"
    /// Gemini API key from Google AI Studio.
    static let geminiAPIKey = "YOUR_GEMINI_API_KEY"
}
